SITE_DOMAIN=yayaue.me

# VPS: /srv/yayaue.me and /srv/peercast-0yp
# Local checkout: /home/megan/src/go/peercast-0yp
PEERCAST_0YP_DIR=../peercast-0yp

# Existing host mysqld credentials. Quote passwords containing $ or # with single quotes.
DB_USER=app
DB_PASSWORD=replace-with-existing-database-password
DB_NAME=peercast_yp
DB_PORT=3306

# To retain existing certificates, set these to the actual old volume names.
CADDY_DATA_VOLUME=yayaue-me-caddy-data
CADDY_CONFIG_VOLUME=yayaue-me-caddy-config

# peercast-mi source checkout and X OAuth credentials (production .env only).
PEERCAST_MI_DIR=../peercast-mi
PEERCAST_X_CLIENT_ID=replace-with-x-client-id
PEERCAST_X_CLIENT_SECRET=replace-with-x-client-secret

# Optional mi audit DB: separate database/user from 0yp. See docs/mi-audit.md.
# Empty credentials retain events in the mi spool until configured and restarted.
PEERCAST_AUDIT_DB_NAME=peercast_mi
PEERCAST_AUDIT_DB_PORT=3306
PEERCAST_AUDIT_DB_USER=
PEERCAST_AUDIT_DB_PASSWORD=
